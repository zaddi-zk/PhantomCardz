# PhantomCardz environment configuration
# Copy to .env and edit. .env is git-ignored.
# NOTE: these values only seed FRESH tables/defaults at first run. On an existing
# database, rotate the admin password via POST /api/user/password.

# Database. Leave blank for SQLite at DATA_DIR/market.db (local development).
# Set to a Supabase PostgreSQL connection string for production, e.g. the
# "Session pooler" URI (IPv4-compatible) copied from Supabase → Settings → Database:
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

SITE_NAME=PhantomCardz
ADMIN_EMAIL=admin@phantomcardz.cc
ADMIN_PASSWORD=CHANGE-ME-BEFORE-PRODUCTION
ADMIN_TELEGRAM=@phantomadmin

CASHAPP_HANDLE=$PhantomCardz
BTC_ADDRESS=bc1qphantom0000000000000000000000000000dead
ETH_ADDRESS=0xPhantom000000000000000000000000000dead
LTC_ADDRESS=ltc1qphantom00000000000000000000dead
SOL_ADDRESS=PhantomSoL1111111111111111111111111111111111

ALLOWED_HOSTS=phantomcardz.cc,www.phantomcardz.cc,localhost,127.0.0.1
COOKIE_SECURE=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Where the "Vouch" button sends users (a Telegram channel/invite or bot link).
TELEGRAM_VOUCH_URL=https://t.me/+3-lMkt-idutkOTIx

# Static salt for password hashing. Set once per deployment and keep it stable;
# changing it invalidates existing password hashes.
PASSWORD_SALT=PhantomCardz-pbkdf2-static-v1

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RESET_DEV_CODE=false

# NOWPayments (real-time crypto). Leave blank to use the legacy static-address
# + manual-approval flow. Get these from https://account.nowpayments.io/ →
# Store settings → API keys / IPN. Set the IPN callback URL to
# https://<your-domain>/api/payments/webhook/nowpayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Override only for the sandbox: https://api-sandbox.nowpayments.io
NOWPAYMENTS_API_BASE=

# Public origin of this app, used for the NOWPayments IPN callback URL.
# e.g. https://phantomcardz.cc
PUBLIC_BASE_URL=

PORT=8000
DATA_DIR=